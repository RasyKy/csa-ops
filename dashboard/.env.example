# Copy to .env.local (Next.js does not read the repo-root .env). Names only here;
# put real values in .env.local or in your host's environment settings, never in
# a tracked file.

# Backend the route handlers and Server Components call.
BACKEND_URL=http://localhost:8000
DASHBOARD_API_KEY=changeme-dashboard-key

# Sign-in (docs/auth.md). Without both of these no one can sign in.
# Hash: node scripts/hash-password.mjs "<password>"   (prints <salt_hex>:<hash_hex>)
DASHBOARD_PASSWORD_HASH=<output of scripts/hash-password.mjs>
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<at least 32 random characters>
# Optional, hours a sign-in lasts. Default 8.
# SESSION_TTL_HOURS=8
