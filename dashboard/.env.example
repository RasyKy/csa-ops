# Copy to .env.local (Next.js does not read the repo-root .env). Names only here;
# put real values in .env.local or in your host's environment settings, never in
# a tracked file.

# FastAPI backend URL, e.g. https://<app>.onrender.com or http://localhost:8000
BACKEND_URL=

# Shared secret sent in X-API-Key header to the backend (must match DASHBOARD_API_KEY on Render; at least 32 characters in production)
DASHBOARD_API_KEY=

# Hash of admin password generated with: node scripts/hash-password.mjs "<password>"
DASHBOARD_PASSWORD_HASH=

# Cryptographically strong secret of at least 32 random characters for signing session tokens
SESSION_SECRET=

# Optional: session time-to-live in hours (default 8)
# SESSION_TTL_HOURS=8

