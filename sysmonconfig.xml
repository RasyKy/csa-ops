<!--
  CSA-OPS trimmed Sysmon configuration.

  Enables ONLY the event types engine/normalizer/consumer.py handles
  (EVENT_FIELD_MAPS in consumer.py):

      1   ProcessCreate    -> process_start
      3   NetworkConnect   -> network_connection
      10  ProcessAccess    -> process_access      (scoped to lsass.exe target)
      11  FileCreate       -> file_event
      12  RegistryEvent    -> registry_event      (key created / deleted)
      13  RegistryEvent    -> registry_event      (value set)

  Any Sysmon event type without a RuleGroup below is not generated, which is
  what keeps this config "trimmed". Winlogbeat then filters the same set again
  (winlogbeat.yml: event_id "1, 3, 10, 11, 12, 13").

  schemaversion 4.90 requires Sysmon v15 or newer.
  Install:  Sysmon64.exe -accepteula -i sysmonconfig.xml
  Update:   Sysmon64.exe -c sysmonconfig.xml
-->
<Sysmon schemaversion="4.90">
  <EventFiltering>

    <!-- Event ID 1: log every process creation -->
    <RuleGroup name="process-create" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
    </RuleGroup>

    <!-- Event ID 3: log every network connection -->
    <RuleGroup name="network-connect" groupRelation="or">
      <NetworkConnect onmatch="exclude" />
    </RuleGroup>

    <!-- Event ID 10: only handle-opens whose target is LSASS -->
    <RuleGroup name="process-access-lsass" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="image">lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event ID 11: log every file creation -->
    <RuleGroup name="file-create" groupRelation="or">
      <FileCreate onmatch="exclude" />
    </RuleGroup>

    <!-- Event IDs 12 & 13: log every registry key and value change -->
    <RuleGroup name="registry" groupRelation="or">
      <RegistryEvent onmatch="exclude" />
    </RuleGroup>

  </EventFiltering>
</Sysmon>
