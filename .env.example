# Copy to .env and fill in real values. .env is gitignored; this file is not.

# --- Auth (backend/app/auth.py, Phase 1) ---
DASHBOARD_API_KEY=changeme-dashboard-key
AGENT_API_KEY=changeme-agent-key

# --- Store (backend/app/store/, Phase 1) ---
STORE_BACKEND=fixtures

# --- Safety (engine/response/safety.py) ---
KILL_SWITCH_PATH=./data/killswitch
RESPONSE_LIVE=false
# JSON array or comma-separated list of hosts allowed to receive live actions.
RESPONSE_LIVE_HOSTS=[]

# --- Intake (backend/app/intake/, Phase 1) ---
INTAKE_ENABLED=true
INTAKE_POLL_SECONDS=2

# --- AI triage (engine/ai_explain/, Phase 5) ---
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

# --- Agent (agent/config.py, Phase 3), only relevant on Machine 1 ---
BACKEND_URL=http://localhost:8000
ENGINE_HOST_IP=127.0.0.1
AGENT_LIVE=false
